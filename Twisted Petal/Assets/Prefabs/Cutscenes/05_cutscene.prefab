  m_Script: {fileID: 11500000, guid: 3a975e36eca21da4383cab3d1f951b27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - '*It''s as I feared... the whole place is in ruins...*'
  - '"Hey! Are you the one who took down that huge monster?"'
  - '"Oh, uh. Yeah."'
  - '"Well, I offer you my thanks. I only wish you were here earlier though."'
  - '"As you can probably tell, this place isn''t really livable anymore. Most of
    the folks moved over to a spot on the coast."'
  - '"Oh, really?"'
  - '"Yeah. Do you have a map on you? I could point it out."'
  - '"Yeah, I do. And that''d be great..."'
  - '*Well, I guess I have a new destination now...*'
