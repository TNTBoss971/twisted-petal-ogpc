  m_Script: {fileID: 11500000, guid: 3a975e36eca21da4383cab3d1f951b27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - '*These plants are getting worse by the day...*'
  - '*Atleast I have a nice view of the beach*'
  - '*Here we are, another station.*'
  - '"Oh hey, a new person. You probably shouldn''t stay here long though."'
  - '"Hm? Why is that?"'
  - '"Well, the plant attacks are especially bad around these parts, so we built
    a perimeter wall around this gas station, but recently one of the bigger ones
    managed to break a hole in it."'
  - '"Nobody''s fixed this hole yet?"'
  - '"Well, we don''t really have the materials for it. It''s a shame, this was a
    nice place to stop, too."'
  - '*Hmm...*'
  - '*I bet I could patch this hole using some of my van''s internal armor plating...
    but that would reduce its integrity by around... 20%.*'
  - '*Yeah... I''ll do it.*'
  - '"Hey, uh, I could probably get you the metal you need?"'
  - '"Really? Thanks, that would be awesome."'
  - '[max hp reduced by 20]'
  - '"Well... that should do it."'
  - '"It looks great! This should hold nicely. I''m glad to see there are still nice
    people around here nowadays."'
  - '"Glad I could help."'
  - '*Hope I don''t end up needing that...*'
  dialoguePortraits:
