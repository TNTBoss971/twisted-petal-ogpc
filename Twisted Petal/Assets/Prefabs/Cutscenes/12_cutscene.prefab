  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - '*Another gas station.*'
  - '*Feel like it''s been a whlie since i''ve seen one of these.*'
  - '*Looks like there''s nobody here.*'
  - '*This one also has a communal supply cache. Looks pretty barren though, not
    much in there...*'
  - '*I might as well put some there for the next person.*'
  - '[3 supplies lost]'
  - '*I''d better rest up. I''ll need it for tomorrow when I head through the forest.*'
