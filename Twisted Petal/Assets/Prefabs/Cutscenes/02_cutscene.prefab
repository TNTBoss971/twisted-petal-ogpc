  m_Script: {fileID: 11500000, guid: 3a975e36eca21da4383cab3d1f951b27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - '*Hm, there are a few more people here at this one.*'
  - '"Hey there!"'
  - '"Oh, um, hi."'
  - '"Are you headed for Government Camp?"'
  - '"Yeah, I heard it was safe there"'
  - '"Well, you''d better be careful!"'
  - '"Why''s that?"'
  - '"I heard something bad happened over there a little while ago."'
  - '"Really? Can you tell me any more?"'
  - '"No, sorry. I haven''t actually been over there myself. I''ve just heard some
    things from some people."'
  - '"I see..."'
  - '*I''m hoping there isn''t any truth to these rumors...*'
