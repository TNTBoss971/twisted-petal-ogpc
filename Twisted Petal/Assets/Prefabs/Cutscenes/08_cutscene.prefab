  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - '*Made it to the next gas station...*'
  - '*Looks like I''m the only one here today. No supplies either...*'
  - '*...*'
  - '*I can''t help but think about that moment from earlier.*'
  - '*It''s probably a good thing I only took what I needed*'
  - '*It''s probably because of selfish people that there aren''t any left at this
    station...*'
